{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:ctx7sk-c7cb35c8-e89d-46ef-9043-375cbbb6398f}"
      },
      "enabled": true
    },

    "word": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "office-word-mcp-server",
        "word_mcp_server"
      ],
      "enabled": true
    }
  }
}
